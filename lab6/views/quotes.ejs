<!DOCTYPE html>
<html lang="en">
<%- include("partials/head") %>
<body>

    <div class="container py-4">
        <div class="page-box">
            <h1 class="text-center mb-3">Famous Quotes</h1>

            <nav class="text-center mb-4">
                <a href="/" class="btn btn-outline-light">Home</a>
            </nav>

            <% if (rows.length === 0) { %>
                <p class="text-center">No quotes found.</p>
            <% } %>

            <% for (let i of rows) { %>
                <div class="quote-card mb-4">
                    <p class="quote-text">"<%= i.quote %>"</p>
                    <p class="quote-author">— <%= i.firstName %> <%= i.lastName %></p>
                </div>
            <% } %>
        </div>
    </div>

    <%- include("partials/footer") %>
</body>
</html>